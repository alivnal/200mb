{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/lib/compress-wasm": [
        "./src/native-compress.ts"
      ],
      "@/lib/platform": [
        "./src/platform.ts"
      ],
      "next/link": [
        "./src/shims/next-link.tsx"
      ],
      "next/dynamic": [
        "./src/shims/next-dynamic.tsx"
      ],
      "@squish/i18n": [
        "../../../v4/apps/web/lib/i18n/index.ts"
      ],
      "@squish/i18n/react": [
        "../../../v4/apps/web/lib/i18n/react.tsx"
      ],
      "@/*": [
        "../../../v4/apps/web/*"
      ]
    }
  },
  "include": [
    "src",
    "electron"
  ]
}
