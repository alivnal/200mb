{
  "name": "@squish/desktop",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --alias:@squish/core=../../packages/squish-core/src/index.ts --outfile=dist-electron/main.js && node -e \"import('node:fs').then(({copyFileSync})=>copyFileSync('electron/preload.cjs','dist-electron/preload.cjs'))\"",
    "dev": "npm run build:electron && concurrently -k \"vite --port 3000\" \"wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "vite build && node ../../scripts/verify-dist.cjs && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "devDependencies": {
    "@squish/core": "*",
    "@squish/i18n": "*",
    "@fontsource/pixelify-sans": "^5.2.7",
    "@fontsource/material-symbols-outlined": "^5.2.45",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.3"
  },
  "description": "Squik — compress and merge academic videos under 200 MB",
  "author": "Squik",
  "build": {
    "appId": "com.kunduz.squish",
    "productName": "Squik",
    "electronVersion": "35.7.5",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/preload.cjs",
      "dist-electron/preload.js"
    ],
    "extraResources": [
      {
        "from": "../../../node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "../../../node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
        "to": "ffprobe.exe"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Squik-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
